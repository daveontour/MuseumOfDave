# Database configuration (required for both commands)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=museum_of_dave
DB_USER=postgres
DB_PASSWORD=your_password

# WhatsApp import - directory containing conversation folders with CSV files
WHATSAPP_DIRECTORY_PATH=/path/to/whatsapp/export

# iMessage import - directory containing conversation folders with CSV files (iMazing export)
IMESSAGE_DIRECTORY_PATH=/path/to/imessage/export

# Facebook Messenger import - directory containing conversation folders with message_*.json files
FACEBOOK_DIRECTORY_PATH=/path/to/facebook/export

# Facebook Albums import - directory containing posts/album or album with *.json files
FACEBOOK_ALBUMS_DIRECTORY_PATH=/path/to/your_facebook_activity/posts

# Facebook Places import - path to posts JSON file or directory of JSON files
FACEBOOK_PLACES_PATH=/path/to/your_posts_1.json

# Instagram import - directory containing conversation folders with message_*.json files
INSTAGRAM_DIRECTORY_PATH=/path/to/instagram/messages/inbox

# Filesystem import - comma-separated directories to scan for images
FILESYSTEM_IMPORT_DIRECTORIES=/path/to/images1,/path/to/images2

# Filesystem import - comma-separated exclude patterns (optional)
FILESYSTEM_EXCLUDE_PATTERNS=*.photostructure
